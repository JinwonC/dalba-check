# Postgres connection string (Neon / Supabase / Vercel Postgres all work)
DATABASE_URL=postgres://user:pass@host:5432/db

# Random secrets. Generate each with: openssl rand -hex 32
AUTH_SECRET=
ENCRYPTION_KEY=

# Google login for managers (Google Cloud Console → OAuth client, Web application)
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only accounts on these domains may sign in (comma separated)
ALLOWED_EMAIL_DOMAINS=dalbausa.com

# Local development only: sign in by typing an email, no Google needed.
# Never set this in production.
DEV_LOGIN=
