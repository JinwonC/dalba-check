# Team access code managers type once per browser. Required in production.
APP_KEY=
# Random secrets. Generate each with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Vercel Blob credentials are added automatically when a private Blob store
# is connected to the project. Without them, data is saved under .data/ (dev only).

# Optional: Google Apps Script bridge (apps-script/Code.gs). When set, the
# manager is emailed when their creator signs, and transfer requests are added
# to the work-request sheet.
APPS_SCRIPT_URL=
APPS_SCRIPT_KEY=
# Company email domains managers may enter (comma separated).
ALLOWED_EMAIL_DOMAINS=dalbausa.com,dalba.com
